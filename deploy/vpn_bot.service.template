[Unit]
Description=VPN Telegram Bot Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=INSTALL_DIR_PLACEHOLDER
Environment=PATH=VENV_DIR_PLACEHOLDER/bin
ExecStart=VENV_DIR_PLACEHOLDER/bin/python3 -m vpn_bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
