# --- BOT SETTINGS ---
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=12345678,87654321

# --- DATABASE SETTINGS ---
# PostgreSQL (Required)
DATABASE_URL=postgresql+asyncpg://vpnbot:vpnbot@localhost:5432/vpnbot
# Connection pool (raise under high concurrent load)
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Cap concurrent MikroTik API calls (shared thread pool)
MIKROTIK_MAX_CONCURRENT=10
# Max seconds to wait for a MikroTik API slot before showing "router busy"
MIKROTIK_SEMAPHORE_WAIT=25
# Per-server connect/apply retries and circuit breaker
MIKROTIK_CONNECT_RETRIES=3
MIKROTIK_RETRY_BACKOFF_SEC=2
MIKROTIK_APPLY_RETRIES=3
MIKROTIK_CIRCUIT_BREAKER_FAILURES=5
MIKROTIK_CIRCUIT_BREAKER_COOLDOWN_SEC=60
MIKROTIK_SOCKET_TIMEOUT=10

# --- MIKROTIK DEFAULTS (Optional) ---
MIKROTIK_HOST=
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_PORT=8728
# WG firewall apply: seconds per attempt (retries use MIKROTIK_APPLY_RETRIES)
WG_MT_APPLY_TIMEOUT=60
WG_MT_LIST_TIMEOUT=15

# --- LIVE MIKROTIK TESTS (copy .env.test.example -> .env.test) ---
# MIKROTIK_TEST_HOST=
# MIKROTIK_TEST_PORT=8728
# MIKROTIK_TEST_PORT_SSL=443
# MIKROTIK_TEST_USERNAME=
# MIKROTIK_TEST_PASSWORD=

# --- SECURITY ---
# Must stay stable — re-run scripts/fix_server_encryption.py if you change it
ENCRYPTION_KEY=

# Optional: Redis URL for distributed rate limiting across bot instances (required for multi-instance production)
# REDIS_URL=redis://localhost:6379/0

# MikroTik API TLS certificate verification (ports 443/8729). Keep true in production.
MIKROTIK_SSL_VERIFY=true

# Optional: distributed rate limiting (required for multi-instance production)
# REDIS_URL=redis://localhost:6379/0

# Optional: Sentry DSN for production error alerting (pip install sentry-sdk)
# SENTRY_DSN=

# Do not use DEBUG=true with production DATABASE_URL (pytest used to encrypt with random keys)
DEBUG=False
