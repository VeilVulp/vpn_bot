# Copy to .env.test and fill in secrets (never commit .env.test)

# Live MikroTik test router (API port 8728, NOT Winbox 8297)
MIKROTIK_TEST_HOST=81.30.108.27
MIKROTIK_TEST_PORT=8728
MIKROTIK_TEST_PORT_SSL=443
MIKROTIK_TEST_WINBOX_PORT=8297
MIKROTIK_TEST_USERNAME=bootuser
MIKROTIK_TEST_PASSWORD=your_password_here

# Isolated test database (recommended)
DATABASE_URL=postgresql+asyncpg://vpnbot:vpnbot@localhost:5432/vpnbot_test

# Optional: isolated DB for destructive backup roundtrip tests (createdb vpnbot_backup_test)
BACKUP_TEST_DATABASE_URL=postgresql+asyncpg://vpnbot:vpnbot@localhost:5432/vpnbot_backup_test
ALLOW_DESTRUCTIVE_BACKUP_TEST=0

# Use the SAME ENCRYPTION_KEY as .env when DATABASE_URL points at vpnbot (not _test)
# ENCRYPTION_KEY is read from .env by tests/conftest.py — do not set empty here
